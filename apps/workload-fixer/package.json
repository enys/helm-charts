{
  "name": "workload-fixer",
  "version": "0.2.0",
  "description": "Kubernetes controller that detects and fixes stuck StatefulSet rolling updates by deleting blocked pods",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src/",
    "test": "node --require ts-node/register --test src/**/*.test.ts"
  },
  "dependencies": {
    "@kubernetes/client-node": "1.4.0",
    "express": "4.22.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "24.13.3",
    "@typescript-eslint/eslint-plugin": "8.0.0",
    "@typescript-eslint/parser": "8.0.0",
    "eslint": "10.10.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
